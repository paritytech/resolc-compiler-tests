  "cases": [
    {
      "name": "Word Width Microbench",
      "comment": "Per-operation cost by op class and word width. Division-family chains use a runtime divisor (general path); divChain/mulmod/addmod use constant divisors (Barrett path). Widths [256, 128, 64, 32, 16, 8] probe newyork narrowing. Each chain runs as 10 independent txs from fresh senders (enough for the profiler's per-step samples); await_transaction_inclusion serializes chains so mined blocks are single-variant. Normalize per-op (charge/n).",
      "inputs": [
        {
          "comment": "Allocate a deployer account.",
          "allocate_account": "$VARIABLE:DEPLOYER_ACCOUNT"
        },
        {
          "comment": "Deploy OpChains once.",
          "instance": "OpChains",
          "method": "#deployer",
          "caller": "$VARIABLE:DEPLOYER_ACCOUNT"
        },
        {
          "comment": "256-bit mulmod, P-256 prime: 512-bit product + 512/256 division (FCL hot op).",
          "start_watcher": true,
          "await_transaction_inclusion": true,
          "repeat": 10,
          "steps": [
            {
              "allocate_account": "$VARIABLE:SENDER"
            },
            {
              "instance": "OpChains",
              "method": "mulmodChain(uint256)",
              "caller": "$VARIABLE:SENDER",
              "calldata": [
                "2000"
              ]
            }
          ]
        },
        {
          "comment": "256-bit addmod, P-256 prime: reduction of a <=257-bit dividend.",
          "await_transaction_inclusion": true,
          "repeat": 10,
          "steps": [
            {
              "allocate_account": "$VARIABLE:SENDER"
            },
            {
              "instance": "OpChains",
              "method": "addmodChain(uint256)",
              "caller": "$VARIABLE:SENDER",
              "calldata": [
                "2000"
              ]
            }
          ]
        },
        {
          "comment": "256-bit wrapping mul: quadratic limb work, no division.",
          "await_transaction_inclusion": true,
          "repeat": 10,
          "steps": [
            {
              "allocate_account": "$VARIABLE:SENDER"
            },
            {
              "instance": "OpChains",
              "method": "mulChain(uint256)",
              "caller": "$VARIABLE:SENDER",
              "calldata": [
                "2000"
              ]
            }
          ]
        },
        {
          "comment": "256-bit add/xor/shift: linear limb work.",
          "await_transaction_inclusion": true,
          "repeat": 10,
          "steps": [
            {
              "allocate_account": "$VARIABLE:SENDER"
            },
            {
              "instance": "OpChains",
              "method": "addXorChain(uint256)",
              "caller": "$VARIABLE:SENDER",
              "calldata": [
                "100000"
              ]
            }
          ]
        },
        {
